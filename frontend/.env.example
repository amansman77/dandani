# API Configuration
REACT_APP_API_URL=https://dandani-api.amansman77.workers.dev

# PostHog Configuration
REACT_APP_POSTHOG_KEY=your_posthog_api_key_here
REACT_APP_POSTHOG_HOST=https://us.i.posthog.com

# KakaoTalk Share (선택)
# developers.kakao.com에서 앱을 만들고 "JavaScript 키"를 여기에 넣는다.
# 플랫폼 > Web 에 dandani.yetimates.com 도메인 등록도 같이 해야 동작한다.
# 값이 없으면 공유 시트에서 카카오 줄이 빠지고 OS 공유 시트로 대체된다.
REACT_APP_KAKAO_JS_KEY=your_kakao_javascript_key_here

# Build Configuration
GENERATE_SOURCEMAP=false
